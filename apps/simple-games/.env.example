# 広告 ID の環境変数はこの 6 つだけ(値は入れない。このファイルは追跡される)。
# 実際の値はローカルの `.env`(追跡外)と GitHub Secrets にあり、
# 出荷ビルドが読むのは Secrets の側 — .github/workflows/android-release.yml と
# web-build.yml。方針は docs/ADS_POLICY.md「広告 ID の管理」。
#
# 名前にプラットフォームを含めるのは、AdMob のアプリ ID・ユニット ID が
# OS ごとに別物だから。iOS 版は Android の名前を使い回さず、下の IOS 側が増える。
#
# ここで VITE_ を付けていないのは意図的で、Vite は VITE_ で始まる変数だけを
# クライアントバンドルへ注入するため。この名前なら `pnpm build` を普通に走らせても
# 本番 ID が dist/ に入らない(自分の広告を自分でタップする事故の防止)。
# ワークフローは本番ビルドのときだけ VITE_ADMOB_ANDROID_BANNER_ID として明示的に渡す。

# --- Android ---
ADMOB_ANDROID_APP_ID=
ADMOB_ANDROID_BANNER_ID=

# --- iOS ---
# banner.ts は Capacitor.getPlatform() で選ぶので、iOS ビルドが Android の ID を
# 読むことはない。APP_ID の側は Xcode のビルド設定 ADMOB_IOS_APP_ID を経由して
# Info.plist の GADApplicationIdentifier へ入る(Android の manifestPlaceholder と
# 同じ形。未設定なら Google のテスト用 app ID にフォールバック)。
ADMOB_IOS_APP_ID=
ADMOB_IOS_BANNER_ID=

# --- Web 版(AdSense)---
# CLIENT だけでアンカー(Auto ads)が有効になる。ディスプレイ枠は
# それぞれの SLOT が CLIENT と揃ったときだけ出る(無い枠は出ないだけ)。
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_RESULT=

# テスト広告の強制(ID ではなくモード指定なので OS をまたいで 1 つ):
#   VITE_ADMOB_USE_TEST_ADS=true     ネイティブ = Google 公式テスト広告
#   VITE_ADSENSE_USE_TEST_ADS=true   Web = 通信ゼロのローカルプレースホルダ
