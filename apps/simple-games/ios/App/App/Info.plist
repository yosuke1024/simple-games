	<!-- AdMob application ID. Mirrors the Android manifest placeholder
	     (android/app/build.gradle): the value comes from the ADMOB_IOS_APP_ID
	     build setting, which the release lane overrides with the production ID
	     and which otherwise falls back to Google's official TEST app ID
	     declared in the Xcode project. The production ID is never committed
	     (docs/ADS_POLICY.md「広告 ID の管理」). AdMob app IDs are per-OS —
	     this is NOT the Android one. -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_IOS_APP_ID)</string>
	<!-- Export compliance: the app uses only the HTTPS that iOS itself and
	     the ad/billing SDKs provide, which is exempt. Declaring it here keeps
	     every upload from asking the same question again. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
