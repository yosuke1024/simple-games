{
  "name": "simple-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simple Games: Offline Puzzles — a collection of simple offline games by PixApps",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "preview": "vite preview",
    "preview:web": "vite preview --mode web",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:gate": "node scripts/i18n-gate.mjs",
    "size:check": "node scripts/bundle-size.mjs check",
    "size:update": "node scripts/bundle-size.mjs update",
    "i18n:gate:check": "I18N_GATE_STRICT=1 vitest run src/i18n/gate.test.ts",
    "verify:changed": "node scripts/verify-changed.mjs",
    "cap": "cap"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capgo/native-purchases": "^8.6.4",
    "@fontsource/nunito": "^5.3.0",
    "@simple-games/brand": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "~8.4.2",
    "@simple-games/eslint-config": "workspace:*",
    "@simple-games/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
