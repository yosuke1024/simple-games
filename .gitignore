# Dependencies
node_modules/

# Build outputs (dist-web/ is the web-mode build — docs/WEB_VERSION.md)
dist/
dist-web/
.turbo/
coverage/

# Logs / OS
*.log
.DS_Store

# Android build outputs (native project itself is committed)
apps/*/android/.gradle/
apps/*/android/build/
apps/*/android/app/build/
apps/*/android/app/release/
apps/*/android/local.properties
apps/*/android/.idea/
apps/*/android/capacitor-cordova-android-plugins/build/

# iOS build outputs (native project itself is committed; ios/.gitignore
# excludes the web-asset copy and generated config beside these)
apps/*/ios/App/build/
apps/*/ios/App/output/
apps/*/ios/DerivedData/

# Signing material must never be committed
*.keystore
*.jks

# Environment files (production ad unit IDs etc. are injected, never committed)
.env
.env.*
!.env.example

# Local Claude Code working files
.claude/scheduled_tasks.lock
